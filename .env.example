# 复制本文件为 .env,然后填入你的 DeepSeek API Key
# 获取地址:https://platform.deepseek.com/api_keys
# 提示:如果你之前配置过 shopkb 或 health-planner,直接复用那个 key 即可。
DEEPSEEK_API_KEY=sk-在这里填入你的key

# 模型(以官方定价页为准:https://api-docs.deepseek.com/zh-cn/quick_start/pricing/)
#
#   deepseek-flash     = DeepSeek-V4.1-Flash,便宜、并发 2500、支持图像理解  ← 默认
#   deepseek-v4-pro    = DeepSeek-V4-Pro,贵 3.4~4.5 倍,并发只有 500
#
# 老名字 `deepseek-chat` 已经不在这张表里了(实测仍可调用,由 V4.1-Flash 提供服务)。
# 遗留别名哪天消失是不通知的,所以这里直接用当前名。
#
# 顺带:空闲时段价格是高峰的一半。高峰 = 工作日 9:00-12:00 与 14:00-18:00,
# 其余(含晚上、周末、节假日)都是空闲 —— 批量采集放到晚上跑能省一半。
DEEPSEEK_MODEL=deepseek-flash

# API 地址,一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# 想采多个 AI 引擎?再加一组三项即可 —— 前缀随便取,配齐了就会被自动发现。
# 加引擎不需要写代码,一行都不用。
#
#   KIMI_API_KEY=sk-...
#   KIMI_BASE_URL=https://api.moonshot.cn/v1
#   KIMI_MODEL=kimi-k3
#
# 注意两种模型不要用:
#   · Kimi 的 `moonshot-v1-*` 系列 2026-08-31 已下线,现在只有 kimi-k3 / kimi-k2.6
#   · Kimi 的思考模型只接受 temperature=1,所以**别配** <PREFIX>_TEMPERATURE,
#     不配就是不传这个参数,让服务商用自己的默认值
